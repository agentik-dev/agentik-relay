# .hygiene-allow: <path-glob>: <group>[,<group>]; `*` stays inside one path segment.
# The groups `person` and `env` come from the private list outside the repo (scripts/hygiene's docstring);
# without that list these entries match nothing.

# The copyright line and the plugin's author field keep the owner's name (packet public-r1's table).
LICENSE: person
plugin/.claude-plugin/plugin.json: person

# The relay's push notifier is a public push service the product supports, and these files name it
# (its config key, the effects notifier type, doctor's check). The private list names that service's
# word for the owner's setup; these files name the product's feature, never a host or topic of the owner's.
